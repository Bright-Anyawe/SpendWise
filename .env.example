# Copy to .env.local and fill in. Never commit .env.local. See docs/neon-setup.md.

# Public URL of the app (used in the password-reset email link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon → your SpendWise Auto project → Connect  (change sslmode=require to sslmode=verify-full)
# Pooled connection (hostname contains "-pooler") — used by the app
DATABASE_URL=
# Direct connection (no "-pooler") — used by `npm run db:migrate`
DATABASE_URL_UNPOOLED=

# Neon → Auth → Configuration: the Auth URL (ends in /auth)
NEON_AUTH_BASE_URL=
# 32+ random characters, signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Web push (Phase 5). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services (Google, Mozilla, Apple) can reach about your pushes: mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the reminder job: the scheduler calls POST /api/cron/notify with
# Authorization: Bearer <CRON_SECRET>. Generate like NEON_AUTH_COOKIE_SECRET above.
CRON_SECRET=
